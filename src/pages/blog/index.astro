---
/* /blog — lists every published article in src/content/blog/, newest first.
   Heading and empty-state text come from site.blog in src/data/site.ts. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import { site } from "../../data/site";
import { findImage } from "../../lib/images";
import { formatDate, getPosts } from "../../lib/posts";

const posts = await getPosts();
const { title, description, heading, intro, emptyMessage } = site.blog;
---

<BaseLayout title={title} description={description}>
  <section class="blog section" aria-labelledby="blog-heading">
    <div class="container">
      <h1 id="blog-heading">{heading}</h1>
      <p class="blog__intro lead">{intro}</p>

      {
        posts.length === 0 ? (
          <p class="blog__empty">{emptyMessage}</p>
        ) : (
          <ol class="blog__list">
            {posts.map((post) => {
              const hasCover = Boolean(findImage(post.data.coverImage));
              return (
                <li class:list={["post-preview", { "post-preview--with-image": hasCover }]}>
                  {hasCover && (
                    <Photo
                      class="post-preview__image"
                      src={post.data.coverImage}
                      alt=""
                      label=""
                      ratio={[16, 9]}
                      sizes="(min-width: 48rem) 280px, 100vw"
                    />
                  )}
                  <div>
                    <h2 class="post-preview__title">
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    <p class="post-preview__meta">
                      <time datetime={post.data.publishedDate.toISOString()}>
                        {formatDate(post.data.publishedDate)}
                      </time>
                      {post.data.draft && " · Draft (not published)"}
                    </p>
                    <p class="post-preview__description">{post.data.description}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog__intro {
    max-width: var(--max-width-text);
    margin-bottom: var(--space-6);
  }
  .blog__empty {
    max-width: var(--max-width-text);
    padding: var(--space-5);
    background: var(--color-green-50);
    border-left: 4px solid var(--color-green-600);
    color: var(--color-text);
  }
  .blog__list {
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .post-preview {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 40rem) {
    .post-preview--with-image {
      grid-template-columns: 15rem 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }
  .post-preview__title {
    margin-bottom: var(--space-1);
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
  }
  .post-preview__title a {
    color: var(--color-green-950);
    text-decoration-color: var(--color-green-200);
    text-decoration-thickness: 2px;
  }
  .post-preview__title a:hover {
    text-decoration-color: var(--color-green-600);
  }
  .post-preview__meta {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .post-preview__description {
    margin: 0;
  }
</style>
