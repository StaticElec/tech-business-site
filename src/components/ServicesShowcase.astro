---
/* Services: a row of tabs and ONE service panel (photo left, text right).
   Content: site.servicesSection + site.services in src/data/site.ts.

   How it works
   - Every service panel is rendered into the HTML at build time.
   - Without JavaScript: the tab row is hidden and all services are listed
     one after another, so nothing is lost.
   - With JavaScript (the <script> at the bottom, a few hundred bytes):
     BaseLayout adds class "js" to <html> before the page paints, CSS stacks
     the panels in one grid cell (so switching never changes the page height),
     and only the selected panel is visible. Clicking a tab fades the current
     panel out, swaps, and fades the new one in (instant with reduced motion).
   - Keyboard: Tab into the tab row, Left/Right arrows move between services,
     Home/End jump to first/last (WAI-ARIA tabs pattern). */
import { site } from "../data/site";
import Photo from "./Photo.astro";

const { heading, intro } = site.servicesSection;
const services = site.services;
---

<section class="services section" aria-labelledby="services-heading">
  <div class="container">
    <h2 id="services-heading">{heading}</h2>
    {intro && <p class="services__intro lead">{intro}</p>}

    <div class="services__tabs" role="tablist" aria-labelledby="services-heading" data-services-tabs>
      {
        services.map((service, i) => (
          <button
            class="services__tab"
            type="button"
            role="tab"
            id={`tab-${service.id}`}
            aria-controls={`panel-${service.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {service.tabLabel}
          </button>
        ))
      }
    </div>

    <div class="services__panels" data-services-panels>
      {
        services.map((service, i) => (
          <div
            class:list={["services__panel", { "is-active": i === 0 }]}
            role="tabpanel"
            id={`panel-${service.id}`}
            aria-labelledby={`tab-${service.id}`}
          >
            <Photo
              src={service.image}
              alt={service.imageAlt}
              label={`Service photo: ${service.title} (landscape, 4:3)`}
              ratio={[4, 3]}
              sizes="(min-width: 46rem) 600px, 100vw"
            />
            <div class="services__text">
              <h3>{service.title}</h3>
              {service.description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__intro {
    max-width: var(--max-width-text);
    margin-bottom: var(--space-6);
  }

  /* ---- Tabs ---- */
  .services__tabs {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
    /* Baseline drawn as an inset shadow (not a border) so the active tab's
       underline can sit on top of it without overflowing the scroll area */
    box-shadow: inset 0 -2px 0 var(--color-border);
    /* Phones: scroll sideways instead of squashing the buttons.
       overflow-y must be explicit: overflow-x: auto alone makes it auto too. */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    /* Hide the scrollbar; touch/trackpad/keyboard scrolling still works */
    scrollbar-width: none;
    /* room for focus outlines inside the scroll area */
    padding: 4px 4px 0;
    margin-inline: -4px;
  }
  .services__tabs::-webkit-scrollbar {
    display: none;
  }
  .services__tab {
    flex: 0 0 auto;
    min-height: var(--tap-size);
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-bottom: 3px solid transparent;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }
  .services__tab:hover {
    color: var(--color-green-900);
    background: var(--color-green-50);
  }
  .services__tab[aria-selected="true"] {
    color: var(--color-green-950);
    background: var(--color-green-100);
    border-bottom-color: var(--color-green-700);
  }
  .services__tab:focus-visible {
    outline-offset: -3px;
  }

  /* ---- Panels ---- */
  .services__panels {
    display: grid;
    gap: var(--space-7);
  }
  .services__panel {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .services__text {
    max-width: 34rem;
  }
  .services__text p {
    color: var(--color-muted);
  }
  .services__text p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 46rem) {
    .services__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(var(--space-6), 5vw, var(--space-8));
    }
  }

  /* No JavaScript: no tabs, every service listed */
  :global(html:not(.js)) .services__tabs {
    display: none;
  }

  /* JavaScript: panels share one grid cell; only the active one is shown */
  :global(html.js) .services__panels {
    gap: 0;
    transition: opacity var(--duration-fade) var(--ease);
  }
  :global(html.js) .services__panels.is-fading {
    opacity: 0;
  }
  :global(html.js) .services__panel {
    grid-area: 1 / 1;
  }
  :global(html.js) .services__panel:not(.is-active) {
    visibility: hidden;
  }
</style>

<script>
  const tablist = document.querySelector<HTMLElement>("[data-services-tabs]");
  const panelsWrap = document.querySelector<HTMLElement>("[data-services-panels]");

  if (tablist && panelsWrap) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Fade length comes from --duration-fade in global.css
    const fadeMs = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--duration-fade")) || 160;
    let timer: number | undefined;

    const showPanel = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        t.tabIndex = selected ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)?.classList.toggle("is-active", selected);
      }
    };

    const select = (tab: HTMLButtonElement) => {
      if (tab.getAttribute("aria-selected") === "true") return;
      tab.scrollIntoView({ block: "nearest", inline: "nearest" });
      window.clearTimeout(timer);
      if (reducedMotion.matches) return showPanel(tab);
      // Fade out, swap content, fade back in
      panelsWrap.classList.add("is-fading");
      timer = window.setTimeout(() => {
        showPanel(tab);
        panelsWrap.classList.remove("is-fading");
      }, fadeMs);
    };

    tablist.addEventListener("click", (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });

    tablist.addEventListener("keydown", (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      const next = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      tabs[next].focus();
      select(tabs[next]);
    });
  }
</script>
