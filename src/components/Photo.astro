---
/* Renders a photo from src/assets/images/ at a fixed aspect ratio, resized and
   compressed by Astro. If the file doesn't exist yet, renders a clearly
   labelled placeholder box of the same size instead (no layout shift either way). */
import { Image } from "astro:assets";
import { findImage } from "../lib/images";

interface Props {
  /** Path from site.ts / frontmatter, e.g. "/src/assets/images/hero-repair.jpg" */
  src?: string;
  alt: string;
  /** Short description of the photo that belongs here (shown on the placeholder) */
  label: string;
  /** Aspect ratio as [width, height] */
  ratio?: [number, number];
  /** Tells the browser how wide the image displays, for picking a file size */
  sizes?: string;
  /** "eager" only for the first image on screen (the hero) */
  loading?: "eager" | "lazy";
  class?: string;
}

const {
  src,
  alt,
  label,
  ratio = [4, 3],
  sizes = "(min-width: 60rem) 50vw, 100vw",
  loading = "lazy",
  class: className,
} = Astro.props;

const image = findImage(src);
const [rw, rh] = ratio;
const style = `aspect-ratio: ${rw} / ${rh}`;
---

{
  image ? (
    <div class:list={["photo", className]} style={style}>
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : "auto"}
        decoding={loading === "eager" ? "sync" : "async"}
      />
    </div>
  ) : (
    <div class:list={["photo", "photo--placeholder", className]} style={style}>
      <div class="photo__note">
        <strong>Photo needed</strong>
        <span>{label}</span>
        {src && <code>{src.replace(/^\//, "")}</code>}
      </div>
    </div>
  )
}

<style>
  .photo {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-green-100);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder: deliberately looks unfinished — hatched, dashed border */
  .photo--placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    border: 2px dashed var(--color-border-strong);
    background-color: var(--color-green-50);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      var(--color-green-100) 14px 16px
    );
  }
  .photo__note {
    display: grid;
    gap: var(--space-1);
    max-width: 24rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-align: center;
  }
  .photo__note strong {
    color: var(--color-green-900);
  }
  .photo__note code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
</style>
