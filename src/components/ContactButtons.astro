---
/* The Call + Message button pair. Used in the header, hero, final CTA and
   mobile bar so the phone link and message link are defined in one place
   (site.contact in src/data/site.ts). */
import { site } from "../data/site";

interface Props {
  /** "light" for light backgrounds, "dark" for dark green backgrounds */
  tone?: "light" | "dark";
  /** Phone number in the Call button: always, only on wider screens, or never
      (it is still read out to screen readers) */
  number?: "always" | "wide" | "never";
  /** Use the short message label (header, mobile bar) */
  short?: boolean;
  /** Smaller padding for the header */
  compact?: boolean;
  class?: string;
}

const { tone = "light", number = "always", short = false, compact = false, class: className } = Astro.props;
const { phone, phoneDisplay, callLabel, message } = site.contact;

const callClass = tone === "dark" ? "button--light" : "button--primary";
const messageClass = tone === "dark" ? "button--outline-light" : "button--secondary";
---

<div class:list={["contact-buttons", { "contact-buttons--compact": compact }, className]}>
  <a class:list={["button", callClass]} href={`tel:${phone}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>
      {callLabel}{" "}<span class:list={[{ "visually-hidden": number === "never", "contact-buttons__wide": number === "wide" }]}>
        {phoneDisplay}
      </span>
    </span>
  </a>
  <a class:list={["button", messageClass]} href={message.href}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>{short ? message.shortLabel : message.label}</span>
  </a>
</div>

<style>
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact-buttons--compact {
    gap: var(--space-2);
  }
  @media (max-width: 59.99rem) {
    .contact-buttons__wide {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  .contact-buttons--compact .button {
    min-height: 44px;
    padding-inline: var(--space-4);
  }
</style>
