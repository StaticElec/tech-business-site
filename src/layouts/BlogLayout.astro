---
/* Layout for a single repair article (src/content/blog/*.md).
   Title, dates, optional cover photo, then the Markdown body in .prose
   (article typography lives in src/styles/global.css). */
import BaseLayout from "./BaseLayout.astro";
import Photo from "../components/Photo.astro";
import { site } from "../data/site";
import { findImage } from "../lib/images";
import { formatDate, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishedDate, updatedDate, coverImage, coverImageAlt, tags, draft } = post.data;
const cover = findImage(coverImage);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { "@type": "Organization", name: site.name },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={cover?.src}
  publishedTime={publishedDate}
  modifiedTime={updatedDate}
  jsonLd={articleLd}
>
  <article class="article section">
    <div class="container article__inner">
      <a class="article__back" href="/blog/"><span aria-hidden="true">&larr;</span> {site.blog.backLabel}</a>

      <header class="article__header">
        {draft && <p class="article__draft">Draft — only visible with npm run dev, not published.</p>}
        <h1>{title}</h1>
        <p class="article__meta">
          <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
          {
            updatedDate && (
              <>
                {" · "}Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
        {tags.length > 0 && <p class="article__tags">{tags.join(", ")}</p>}
      </header>

      {
        coverImage && (
          <Photo
            class="article__cover"
            src={coverImage}
            alt={coverImageAlt ?? ""}
            label="Article cover photo (landscape, 16:9)"
            ratio={[16, 9]}
            sizes="(min-width: 48rem) 672px, 100vw"
            loading="eager"
          />
        )
      }

      <div class="prose">
        <slot />
      </div>

      <p class="article__footer">
        <a href="/blog/"><span aria-hidden="true">&larr;</span> {site.blog.backLabel}</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .article__inner {
    max-width: calc(var(--max-width-text) + 2 * var(--gutter));
  }
  .article__back,
  .article__footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
  }
  .article__header {
    margin-block: var(--space-4) var(--space-6);
  }
  .article__header h1 {
    font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.5rem);
    margin-bottom: var(--space-3);
  }
  .article__meta,
  .article__tags {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .article__draft {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--color-green-100);
    border: 1px solid var(--color-green-200);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-green-900);
  }
  .article__inner > :global(.article__cover) {
    margin-bottom: var(--space-6);
  }
  .article__footer {
    margin: var(--space-7) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
</style>
